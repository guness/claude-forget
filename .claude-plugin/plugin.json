{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "claude-forget",
  "displayName": "Claude Forget",
  "version": "0.1.0",
  "description": "Adds /forget — pairs with /clear to wipe the slate: clears context and permanently deletes the current session's transcript and the project memory, so it can't be resumed or listed.",
  "author": {
    "name": "Sinan GUNES",
    "email": "claude@sinangunes.com",
    "url": "https://github.com/guness"
  },
  "homepage": "https://github.com/guness/claude-forget#readme",
  "repository": "https://github.com/guness/claude-forget",
  "license": "MIT",
  "keywords": ["session", "privacy", "cleanup", "clear", "forget", "history"],
  "defaultEnabled": true
}
