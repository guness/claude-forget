{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "forget",
  "displayName": "Forget",
  "version": "0.3.0",
  "description": "Adds /forget:session (wipe the current session), /forget:project (nuke every Claude-realm reference to the whole project), and /forget:cancel. Never touches your source files.",
  "author": {
    "name": "Sinan GUNES",
    "email": "claude@sinangunes.com",
    "url": "https://github.com/guness"
  },
  "homepage": "https://github.com/guness/claude-forget#readme",
  "repository": "https://github.com/guness/claude-forget",
  "license": "MIT",
  "keywords": ["session", "privacy", "cleanup", "clear", "forget", "history"],
  "defaultEnabled": true
}
