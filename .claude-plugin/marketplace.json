{
  "$schema": "https://json.schemastore.org/claude-code-marketplace-manifest.json",
  "name": "claude-forget",
  "description": "Self-hosted marketplace for the claude-forget plugin.",
  "version": "0.2.2",
  "owner": {
    "name": "Sinan GUNES",
    "email": "claude@sinangunes.com"
  },
  "plugins": [
    {
      "name": "claude-forget",
      "displayName": "Claude Forget",
      "source": "./",
      "description": "Adds /forget (wipe the current session) and /forget-project (nuke every Claude-realm reference to the whole project). Never touches your source files.",
      "version": "0.2.2",
      "author": {
        "name": "Sinan GUNES",
        "email": "claude@sinangunes.com"
      },
      "homepage": "https://github.com/guness/claude-forget#readme",
      "repository": "https://github.com/guness/claude-forget",
      "license": "MIT",
      "keywords": ["session", "privacy", "cleanup", "clear", "forget", "history"],
      "category": "productivity",
      "defaultEnabled": true
    }
  ]
}
